# Wiki.js 3 REST API Configuration

# Base URL of your Wiki.js 3 installation (no /graphql, no /_api suffix)
WIKIJS_API_URL=https://your-wikijs-installation

# Personal access token (Wiki.js 3: your profile -> API tokens / personal access tokens).
# The token acts as the user who created it, so that user needs read/write/manage
# rights on the pages. Give the token the "pages" scope.
WIKIJS_API_TOKEN=your-api-token-here

# Optional: site ID. Normally resolved automatically from the hostname in
# WIKIJS_API_URL via /_api/bootstrap. Set it only if that lookup finds no site
# (e.g. the wiki is reached under an internal hostname behind a proxy).
# WIKIJS_SITE_ID=
